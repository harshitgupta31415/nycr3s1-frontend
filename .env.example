# Server-only backend URL used by the dbsentinal API proxy.
BACKEND_URL=http://localhost:8080

# Canonical public frontend URL used by Next.js metadata.
SITE_URL=https://dbsentinal.get200.qd.je

# Optional. When blank, dbsentinal keeps the anonymous opaque-ID hackathon
# flow. Set this public key together with backend Clerk credentials to enable
# sign-in and owner-isolated analysis access.
# Use a pk_test_ key for localhost. Clerk production keys only accept the
# configured production domain and are intentionally ignored during local dev.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_AUTH_REQUIRED=false

